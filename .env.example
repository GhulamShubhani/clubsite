# --- Supabase PostgreSQL ---
# URL-encode special chars in passwords (@ → %40).
# Use the Session pooler (pooler.supabase.com), not db.*.supabase.co — that host is
# often IPv6-only and Prisma on Windows cannot connect ("Can't reach database server").

DIRECT_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require&pool_timeout=20"
# Session pooler host must match Project Settings → region (example: ap-northeast-1).
# SUPABASE_REGION="ap-northeast-1"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App host (no protocol). Production: your Vercel domain e.g. clubsite-tau.vercel.app
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
AUTH_URL="http://localhost:3000"
