# URL-encode special chars in the password (e.g. @ → %40)
# Example: postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:REPLACE_ME@db.PROJECT.supabase.co:5432/postgres?sslmode=require"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App host (no protocol). Used for subdomain routing.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
AUTH_URL="http://localhost:3000"
