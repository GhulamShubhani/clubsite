# --- Supabase PostgreSQL ---
# URL-encode special chars in passwords (@ → %40).

# LOCAL / migrations: direct connection (port 5432)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# RUNTIME (required on Vercel): Transaction pooler (port 6543) — get from Supabase → Connect → ORMs → Prisma
# Or keep direct URL below; on Vercel we auto-rewrite to the pooler (set SUPABASE_REGION if needed, default ap-south-1).
# DATABASE_POOLER_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Optional on Vercel when using direct URL (auto-rewritten to pooler). Default: ap-south-1
# SUPABASE_REGION="ap-south-1"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App host (no protocol). Production: your Vercel domain e.g. clubsite-tau.vercel.app
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
AUTH_URL="http://localhost:3000"
